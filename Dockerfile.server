# Production Dockerfile for Enterprise HR API Gateway (Node.js Express Server)
FROM node:20-alpine

WORKDIR /app

# Copy package manifests
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy full source
COPY . .

# Cloud Run uses PORT environment variable (defaults to 8080)
ENV PORT=8080
EXPOSE 8080

# Start Express API Gateway
CMD ["node", "server/index.js"]
