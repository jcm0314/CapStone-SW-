# Check-Mate (HR AX Smart Evaluator) 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 사용하세요. (비밀키가 포함된 .env 파일은 절대 커밋하지 마세요)

# [Frontend - Vite] — 브라우저 번들에 포함되므로 비밀값을 넣지 마세요 (AI 키는 프론트엔드에 두지 않습니다)
VITE_API_GATEWAY_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [Backend - Express API Gateway (server/index.js)] — 서버 전용
PORT=3001
# Claude API (Anthropic) 키: https://console.anthropic.com 에서 발급. 서버에서만 사용됩니다.
ANTHROPIC_API_KEY=
# 비워두면 기본값 claude-haiku-5-5 (가장 저렴). 품질을 더 올리려면 claude-sonnet-5-5 / claude-opus-5-5
ANTHROPIC_MODEL=
# 선택: low | medium | high | xhigh | max (기본 medium)
ANTHROPIC_EFFORT=
# 선택: 에이전트 1회 호출 타임아웃(ms, 기본 120000)
ANTHROPIC_TIMEOUT_MS=
SSO_TOKEN_SECRET=replace-with-strong-hmac-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 선택: 지원자 결과 메일 (Resend → API Keys). 비워 두면 메일 기능만 꺼집니다
# RESEND_FROM 의 도메인은 Resend → Domains 에서 인증해야 합니다
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
