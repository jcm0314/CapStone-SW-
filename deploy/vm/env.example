# 복사해서 쓰기: cp env.example .env && chmod 600 .env
# .env 는 .gitignore 에 걸려 있어 커밋되지 않습니다. 이 파일(env.example)에는 실제 값을 넣지 마세요.

# 접속 주소 (Cloudflare Tunnel 의 Public Hostname 과 정확히 같아야 함, 끝에 / 없이)
PUBLIC_URL=https://checkmate.example.com

# Claude API 키 (Anthropic Console 발급)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 게이트웨이 SSO 토큰 서명 키. 아래 명령으로 만든 값을 넣기: openssl rand -hex 32
SSO_TOKEN_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels 에서 받은 토큰 (eyJ... 로 시작). 비밀번호처럼 다루기
TUNNEL_TOKEN=

# ── 선택: Spring 코어 API (docker compose --profile core) ──
# SPRING_PUBLIC_URL=https://checkmate.example.com/core
# JWT_SECRET=          # openssl rand -hex 32
# CHECKMATE_SEED_PASSWORD=   # 데모 계정 비밀번호. 저장소에 적힌 기본값을 쓰지 말 것
